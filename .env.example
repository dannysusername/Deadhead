# Copy to .env and fill in. .env is gitignored — never commit real values.

# Encryption key for the Anthropic API keys pilots add in Settings.
# 32 random bytes, base64. Generate one with:
#   head -c 32 /dev/urandom | base64
# REQUIRED in production. Left unset, a key is generated into data/secret.key,
# which is fine on a laptop but sits next to the database it protects.
# DEADHEAD_SECRET_KEY=

# Optional: Postgres for production. Unset locally -> SQLite at data/deadhead.db.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Optional: overrides the default 8787.
# PORT=8787

# NOTE: there is no server-wide ANTHROPIC_API_KEY. Each pilot adds their own key
# under Settings, and their own account is billed for their own parsing.
